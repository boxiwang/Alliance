{
  "meta": {
    "project": "RUGLANDS",
    "phase": "personal-mode MVP · Slice 1 · in-city",
    "version": "0.3",
    "reference": "CoC-early pacing; economy redefined to Cash/Oil/Power + Navy/Army/Air per owner spec",
    "curve": "value(L) = round(base * growth^(L-1)); times in seconds; production per hour",
    "note": "Numeric source of truth, keyed by bible Keys (see docs/naming-bible.md §20). Townhall to L30; shield lifts at L10. Outside-city/world-map is a later phase."
  },

  "global": {
    "keepGatesEverything": true,
    "buildingMaxLevel": 30,
    "buildingLevelCappedByKeep": true,
    "buildQueueSlots": 2,
    "buildQueueSlotsNote": "2 builders; extra via res.premium later",

    "combat": {
      "note": "deterministic-ish, non-destructive. Buildings/keep NEVER destroyed.",
      "attackPower": "sum(troops * troop.attack) * marchBonus",
      "defensePower": "sum(defenderTroops * troop.defense) + building.wall.defenseValue + keepDefenseBonus",
      "winRatio": "AP / (AP + DP)",
      "lootRate": 0.5,
      "casualtyScaling": 0.6,
      "woundedRatio": 0.7,
      "woundedNote": "70% of casualties wounded (hospital, healable, capped); 30% dead",
      "keepDefenseBonusPerLevel": 40
    },

    "might": {
      "note": "stat.might = sum(building power per-level * level) + sum(troops * troop.power)",
      "buildingPowerPerLevel": {
        "building.keep": 40, "building.bank": 8, "building.oilwell": 8, "building.powerplant": 8,
        "building.storage": 6, "building.barracks": 12, "building.hospital": 6, "building.embassy": 6,
        "building.wall": 5, "building.academy": 10, "building.watchtower": 5, "building.milestone": 0
      }
    },

    "offline": { "collectorCapHours": 12, "note": "producers bank up to 12h then sit full until collected; storage cap also applies" },

    "shield": {
      "protectedUntilKeepLevel": 10,
      "breaksOnOffensiveAction": true,
      "purchasable": { "durationsHours": [8, 24, 72], "priceIn": "res.premium", "priceNote": "tune later" },
      "note": "sys.shield — new keeps protected until Townhall L10, OR until the player attacks (shield drops). Extra shields purchasable."
    },

    "player": {
      "autoNamePattern": "Ruglord{7digits}",
      "rename": { "firstFree": true, "subsequentCost": { "res.premium": 200 } }
    },

    "march": { "capacityFractionOfMaxTroops": 1.0, "baseTravelSecondsPerTile": 6, "note": "sys.march_capacity — world-map phase" }
  },

  "resources": {
    "res.cash":  { "produced": true, "producer": "building.bank",       "label": "Cash",  "usedFor": ["construction", "training", "research"] },
    "res.oil":   { "produced": true, "producer": "building.oilwell",    "label": "Oil",   "usedFor": ["construction", "training", "research"] },
    "res.power": { "produced": true, "producer": "building.powerplant", "label": "Power", "usedFor": ["construction", "training", "research"] },
    "res.premium": { "produced": false, "label": "Gems", "note": "premium currency: shields / rename / speedups (monetization)" }
  },

  "startingLayout": {
    "keep": 1,
    "prebuilt": ["building.bank", "building.oilwell", "building.powerplant", "building.barracks"],
    "startingResources": { "res.cash": 800, "res.oil": 500, "res.power": 500, "res.premium": 50 },
    "startingTroops": { "troop.army": 0, "troop.navy": 0, "troop.air": 0 }
  },

  "buildings": {
    "building.keep": {
      "unlockAtKeep": 1, "maxLevel": 30,
      "cost": { "res.cash": {"base":500,"growth":1.45}, "res.oil": {"base":300,"growth":1.45}, "res.power": {"base":300,"growth":1.45} },
      "time": { "base":60, "growth":1.6 },
      "role": "Gates everything, unlocks buildings. Shield lifts at L10. Progression to L30."
    },
    "building.bank":       { "unlockAtKeep": 1, "maxLevel": 30, "produces": "res.cash",  "productionPerHour": {"base":150,"growth":1.35},
      "cost": { "res.cash": {"base":120,"growth":1.4}, "res.oil": {"base":60,"growth":1.4}, "res.power": {"base":40,"growth":1.4} }, "time": {"base":30,"growth":1.55} },
    "building.oilwell":    { "unlockAtKeep": 1, "maxLevel": 30, "produces": "res.oil",   "productionPerHour": {"base":120,"growth":1.35},
      "cost": { "res.cash": {"base":120,"growth":1.4}, "res.power": {"base":60,"growth":1.4} }, "time": {"base":30,"growth":1.55} },
    "building.powerplant": { "unlockAtKeep": 1, "maxLevel": 30, "produces": "res.power", "productionPerHour": {"base":120,"growth":1.35},
      "cost": { "res.cash": {"base":120,"growth":1.4}, "res.oil": {"base":60,"growth":1.4} }, "time": {"base":30,"growth":1.55} },
    "building.storage":    { "unlockAtKeep": 2, "maxLevel": 30, "capacityPerResource": {"base":5000,"growth":1.45}, "protectedFraction": 0.35,
      "cost": { "res.cash": {"base":140,"growth":1.45}, "res.oil": {"base":80,"growth":1.45}, "res.power": {"base":80,"growth":1.45} }, "time": {"base":40,"growth":1.6} },
    "building.barracks":   { "unlockAtKeep": 1, "maxLevel": 30, "troopCapacity": {"base":200,"growth":1.28}, "trainSpeedMult": {"base":1.0,"perLevel":0.05}, "trainQueueSize": {"base":20,"growth":1.2},
      "cost": { "res.cash": {"base":180,"growth":1.5}, "res.oil": {"base":120,"growth":1.5}, "res.power": {"base":90,"growth":1.5} }, "time": {"base":45,"growth":1.6},
      "role": "Trains all troop types; sets max troop capacity." },
    "building.hospital":   { "unlockAtKeep": 3, "maxLevel": 30, "woundedCapacity": {"base":150,"growth":1.4}, "healTimePerTroopSec": 2, "healCostPerTroop": { "res.cash": 4 },
      "cost": { "res.cash": {"base":160,"growth":1.45}, "res.oil": {"base":100,"growth":1.45}, "res.power": {"base":90,"growth":1.45} }, "time": {"base":45,"growth":1.6} },
    "building.embassy":    { "unlockAtKeep": 5, "maxLevel": 30, "reinforcementCapacity": {"base":100,"growth":1.3},
      "cost": { "res.cash": {"base":150,"growth":1.4}, "res.oil": {"base":100,"growth":1.4}, "res.power": {"base":80,"growth":1.4} }, "time": {"base":50,"growth":1.6},
      "role": "Receives allied reinforcement troops (capacity). Reinforcement mechanic = Phase 2." },
    "building.wall":       { "unlockAtKeep": 2, "maxLevel": 30, "defenseValue": {"base":200,"growth":1.5},
      "cost": { "res.cash": {"base":100,"growth":1.5}, "res.oil": {"base":80,"growth":1.5}, "res.power": {"base":60,"growth":1.5} }, "time": {"base":35,"growth":1.55} },
    "building.academy":    { "unlockAtKeep": 4, "maxLevel": 30, "researchBranches": ["troops", "economy", "development"],
      "cost": { "res.cash": {"base":200,"growth":1.5}, "res.oil": {"base":140,"growth":1.5}, "res.power": {"base":120,"growth":1.5} }, "time": {"base":60,"growth":1.65},
      "role": "Research Institute: Troops / Economy(RSS) / Development(storage cap, troop count, build speed…). Research nodes = Phase 2." },
    "building.watchtower": { "unlockAtKeep": 3, "maxLevel": 30, "soloTaskSlots": {"base":2,"growth":1.12},
      "cost": { "res.cash": {"base":130,"growth":1.4}, "res.oil": {"base":80,"growth":1.4}, "res.power": {"base":70,"growth":1.4} }, "time": {"base":40,"growth":1.55},
      "role": "Issues solo (PvE) tasks/quests. Task content = later." },
    "building.milestone":  { "unlockAtKeep": 1, "special": "server_progress", "upgradable": false,
      "role": "Monument — shows server-wide progress and triggers server-wide rewards. Display/meta, not a resource-upgrade building. Backend-driven, later." }
  },

  "troops": {
    "troop.army": { "arm": "ground", "unlockAtKeep": 1, "cost": { "res.cash": 15, "res.oil": 10 }, "trainTimeSec": 6,  "attack": 6,  "defense": 6, "power": 5, "load": 12 },
    "troop.navy": { "arm": "sea",    "unlockAtKeep": 1, "cost": { "res.cash": 20, "res.oil": 15 }, "trainTimeSec": 9,  "attack": 8,  "defense": 5, "power": 7, "load": 8 },
    "troop.air":  { "arm": "air",    "unlockAtKeep": 1, "cost": { "res.cash": 25, "res.power": 15 }, "trainTimeSec": 12, "attack": 10, "defense": 4, "power": 9, "load": 6 }
  }
}
