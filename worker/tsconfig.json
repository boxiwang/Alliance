{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // DOM is here only for typecheck: the worker imports the shared client engine
    // (src/lib), whose DOM-global refs (localStorage/window) are runtime-guarded
    // and never execute in the worker.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["*.ts", "worker-configuration.d.ts"]
}
